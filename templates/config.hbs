<form class="easy-traps-config" autocomplete="off">
  <header class="et-config-hero">
    <div class="et-config-logo"><i class="fa-solid fa-dungeon"></i></div>
    <div>
      <h1>EasyTraps</h1>
      <p>World rules, spell sources, technical artwork, and this GM client's creation defaults.</p>
    </div>
    <span class="et-config-version">v{{version}}</span>
  </header>

  <nav class="et-config-tabs" role="tablist" aria-label="EasyTraps configuration sections">
    <a class="{{#if visualsActive}}active{{/if}}" data-tab-target="visuals" role="tab" aria-selected="{{visualsActive}}">
      <i class="fa-solid fa-palette"></i><span>Visuals</span>
    </a>
    <a class="{{#if sourcesActive}}active{{/if}}" data-tab-target="sources" role="tab" aria-selected="{{sourcesActive}}">
      <i class="fa-solid fa-book-open"></i><span>Spell Sources</span>
    </a>
    <a class="{{#if defaultsActive}}active{{/if}}" data-tab-target="defaults" role="tab" aria-selected="{{defaultsActive}}">
      <i class="fa-solid fa-sliders"></i><span>Defaults</span>
    </a>
    <a class="{{#if discoveryActive}}active{{/if}}" data-tab-target="discovery" role="tab" aria-selected="{{discoveryActive}}">
      <i class="fa-solid fa-magnifying-glass-location"></i><span>Discovery</span>
    </a>
  </nav>

  <section class="et-config-panel {{#if visualsActive}}active{{/if}}" data-tab="visuals">
    <div class="et-section-title-row"><div><h2>Technical Tile artwork</h2><p class="et-section-copy">Artwork used by ordinary Tile triggers and separate spell-origin Tiles.</p></div><span class="et-scope-badge"><i class="fa-solid fa-earth-americas"></i> World</span></div>

    <div class="et-visual-grid">
      <article class="et-visual-card">
        <div class="et-visual-preview">
          <img data-image-preview="triggerTexture" data-fallback="{{defaultTriggerTexture}}" src="{{triggerTexture}}" alt="Trigger Tile preview">
        </div>
        <div class="et-visual-body">
          <div class="et-card-title"><i class="fa-solid fa-bullseye"></i><span><b>Trigger Tile</b><small>Visible artwork for ordinary Tile triggers. Door and Item Pile controllers remain technical/invisible.</small></span></div>
          <label class="et-field">
            <span>Image path</span>
            <div class="et-file-field">
              <input type="text" name="triggerTexture" value="{{triggerTexture}}" spellcheck="false">
              <button type="button" data-action="browse-image" data-type="image" data-target="triggerTexture" title="Browse images"><i class="fa-solid fa-folder-open"></i></button>
            </div>
          </label>
          <button type="button" class="et-subtle-button" data-action="reset-image" data-target="triggerTexture" data-default-image="{{defaultTriggerTexture}}"><i class="fa-solid fa-arrow-rotate-left"></i> Use default</button>
        </div>
      </article>

      <article class="et-visual-card">
        <div class="et-visual-preview et-origin-preview">
          <img data-image-preview="originTexture" data-fallback="{{defaultOriginTexture}}" src="{{originTexture}}" alt="Origin Tile preview">
        </div>
        <div class="et-visual-body">
          <div class="et-card-title"><i class="fa-solid fa-location-dot"></i><span><b>Origin Tile</b><small>The optional point from which the spell originates.</small></span></div>
          <label class="et-field">
            <span>Image path</span>
            <div class="et-file-field">
              <input type="text" name="originTexture" value="{{originTexture}}" spellcheck="false">
              <button type="button" data-action="browse-image" data-type="image" data-target="originTexture" title="Browse images"><i class="fa-solid fa-folder-open"></i></button>
            </div>
          </label>
          <button type="button" class="et-subtle-button" data-action="reset-image" data-target="originTexture" data-default-image="{{defaultOriginTexture}}"><i class="fa-solid fa-arrow-rotate-left"></i> Use default</button>
        </div>
      </article>
    </div>

    <div class="et-config-note"><i class="fa-solid fa-circle-info"></i><span>Existing traps keep their current artwork. Door and Item Pile source indicators are generated by EasyTraps and do not use these images.</span></div>
  </section>

  <section class="et-config-panel {{#if sourcesActive}}active{{/if}}" data-tab="sources">
    <div class="et-section-title-row">
      <div><h2>Spell compendiums</h2><p class="et-section-copy">Choose which spell Item packs feed the creation wizard.</p></div>
      <div class="et-section-title-actions"><span class="et-scope-badge"><i class="fa-solid fa-earth-americas"></i> World</span><div class="et-selection-count"><b data-pack-count>{{selectedPackCount}}</b><span>selected</span></div></div>
    </div>

    {{#if hasSpellPacks}}
    <div class="et-source-toolbar">
      <label class="et-search-field"><i class="fa-solid fa-magnifying-glass"></i><input type="search" name="packSearch" placeholder="Search sources..."></label>
      <div class="et-source-actions">
        <button type="button" data-pack-action="defaults" title="Use the standard SRD spell sources"><i class="fa-solid fa-book"></i> SRD</button>
        <button type="button" data-pack-action="all"><i class="fa-solid fa-check-double"></i> Select all</button>
        <button type="button" data-pack-action="none"><i class="fa-solid fa-xmark"></i> Clear</button>
      </div>
    </div>

    <div class="et-pack-summary"><span data-pack-shown>{{packCount}} available</span></div>
    <div class="et-pack-list">
      {{#each packs}}
      <label class="et-pack-row" data-pack-row data-search="{{search}}">
        <input type="checkbox" name="compendium" value="{{id}}" data-default-pack="{{isDefault}}" {{checked selected}}>
        <span class="et-pack-check"><i class="fa-solid fa-check"></i></span>
        <span class="et-pack-copy"><b>{{label}}</b><small>{{id}}{{#if packageLabel}} · {{packageLabel}}{{/if}}</small></span>
      </label>
      {{/each}}
    </div>
    <div class="et-config-note et-source-warning" data-pack-empty-warning {{#unless noSelectedSpellPacks}}hidden{{/unless}}><i class="fa-solid fa-triangle-exclamation"></i><span>No spell source is selected. You can save this intentionally, but the Create Spell Trap wizard will have no spells until a source is selected.</span></div>
    {{else}}
    <div class="et-empty-state"><i class="fa-solid fa-book-circle-xmark"></i><span><b>No spell compendium is available</b><small>You can still configure every other EasyTraps section. The creation wizard will remain unavailable until an enabled Item compendium containing spells exists.</small></span></div>
    {{/if}}
  </section>

  <section class="et-config-panel {{#if defaultsActive}}active{{/if}}" data-tab="defaults">
    <div class="et-section-title-row"><div><h2>Creation defaults</h2><p class="et-section-copy">Values remembered by this browser/client for the next trap you create.</p></div><span class="et-scope-badge is-client"><i class="fa-solid fa-display"></i> This client</span></div>

    <div class="et-default-grid">
      <label class="et-value-card">
        <span class="et-value-icon"><i class="fa-solid fa-shield-halved"></i></span>
        <span class="et-value-copy"><b>Spell save DC</b><small>Starting save DC for a new trap.</small></span>
        <input type="number" min="1" max="99" step="1" name="defaultSpellSaveDc" value="{{spellSaveDc}}">
      </label>

      <label class="et-value-card">
        <span class="et-value-icon"><i class="fa-solid fa-crosshairs"></i></span>
        <span class="et-value-copy"><b>Spell attack bonus</b><small>Starting flat modifier for spell attacks.</small></span>
        <input type="text" inputmode="numeric" name="defaultSpellAttackBonus" value="{{spellAttackBonus}}">
      </label>
    </div>

    <h2>New-trap behavior</h2>
    <label class="et-toggle-card">
      <span><b>Pause when triggered</b><small>Pause immediately before the spell begins resolving.</small></span>
      <input type="checkbox" name="defaultPauseOnTrigger" {{checked pauseOnTrigger}}>
    </label>
    <label class="et-toggle-card">
      <span><b>Disarm after triggering</b><small>New traps start as single-use unless changed per trap.</small></span>
      <input type="checkbox" name="defaultDisarmAfterTrigger" {{checked disarmAfterTrigger}}>
    </label>
  </section>

  <section class="et-config-panel {{#if discoveryActive}}active{{/if}}" data-tab="discovery">
    <div class="et-section-title-row">
      <div><h2>Discovery & disarming</h2><p class="et-section-copy">World defaults copied into new traps. Each trap can override them from Advanced Settings.</p></div>
      <span class="et-scope-badge"><i class="fa-solid fa-earth-americas"></i> World</span>
    </div>

    <label class="et-toggle-card et-discovery-master">
      <span><b>Enable discovery & disarming for new traps</b><small>New traps receive the rules below. Existing traps are changed only when you use Apply to all from a trap.</small></span>
      <input type="checkbox" name="discoveryEnabled" {{checked discovery.enabled}}>
    </label>

    <div class="et-config-discovery-body" data-config-discovery-body>
      <div class="et-config-rule-card">
        <header><span class="et-rule-number">1</span><span><b>Detection</b><small>Perception can use automatic Passive Perception. Investigation is manual/GM-driven and never auto-discovers a trap.</small></span></header>
        <div class="et-config-rule-grid">
          <label class="et-field"><span>Detection DC</span><input type="number" name="detectionDC" min="1" max="99" step="1" value="{{discovery.detection.dc}}"></label>
          <label class="et-field"><span>Detection skill</span><select name="detectionSkill"><option value="perception" {{#if detectionPerception}}selected{{/if}}>Wisdom (Perception)</option><option value="investigation" {{#if detectionInvestigation}}selected{{/if}}>Intelligence (Investigation)</option></select></label>
          <label class="et-field"><span>Detection range</span><div class="et-inline-unit"><input type="number" name="detectionDistance" min="0" max="999" step="5" value="{{discovery.detection.distance}}"><b>ft</b></div></label>
        </div>
        <div class="et-config-toggle-grid">
          <label class="et-toggle-card"><span><b>Automatic Passive Perception</b><small>Uses the Passive Perception already calculated by D&D5e on the Actor. Available only when Perception is selected.</small></span><input type="checkbox" name="passiveDiscovery" {{checked discovery.detection.passive}}></label>
          <label class="et-toggle-card"><span><b>Require line of sight</b><small>Sight-blocking walls and closed barriers must not obstruct the trap.</small></span><input type="checkbox" name="requireLOS" {{checked discovery.detection.requireLOS}}></label>
          <label class="et-toggle-card"><span><b>Pause when discovered</b><small>Pause when automatic discovery succeeds.</small></span><input type="checkbox" name="pauseOnDiscovery" {{checked discovery.detection.pauseOnDiscovery}}></label>
        </div>
      </div>

      <div class="et-config-rule-card">
        <header><span class="et-rule-number">2</span><span><b>Disarming</b><small>Use the native Dexterity (Sleight of Hand) check. Thieves' Tools can be required as an optional physical item.</small></span></header>
        <div class="et-config-rule-grid et-config-rule-grid-disarm">
          <label class="et-field"><span>Disarm DC</span><input type="number" name="disarmDC" min="1" max="99" step="1" value="{{discovery.disarm.dc}}"></label>
          <div class="et-config-static"><span>Disarm check</span><b>Dexterity (Sleight of Hand)</b></div>
          <div class="et-config-static"><span>Interaction reach</span><b>5 ft from the real trigger source</b></div>
        </div>
        <label class="et-toggle-card"><span><b>Require Sleight of Hand proficiency</b><small>Optional stricter restriction. Off by default under the 2024 baseline.</small></span><input type="checkbox" name="requireDisarmProficiency" {{checked discovery.disarm.requireProficiency}}></label>

        <div class="et-config-required-item-card {{#if requiredToolIsDefault}}is-default{{/if}}" data-default-tool-card data-default-tool-drop-zone>
          <label class="et-config-required-item-check" title="Require the selected item to attempt a disarm">
            <input type="checkbox" name="requireRequiredItem" {{checked requireRequiredItem}}>
          </label>
          <div class="et-config-required-item-drag" draggable="true" data-required-tool-drag data-uuid="{{requiredToolUuid}}" title="Drag this Item to a character sheet">
            <img src="{{requiredToolImg}}" alt="">
            <span><b data-default-tool-name>{{requiredToolName}}</b><small>Drop another Item here to replace it · drag this item to a character sheet.</small></span>
          </div>
          <button type="button" class="et-config-required-item-reset" data-action="reset-default-tool" title="Restore Thieves' Tools" {{#if requiredToolIsDefault}}disabled{{/if}}><i class="fa-solid fa-rotate-left"></i></button>
          <input type="hidden" name="requiredToolUuid" value="{{requiredToolUuid}}">
          <input type="hidden" name="requiredToolName" value="{{requiredToolName}}">
          <input type="hidden" name="requiredToolImg" value="{{requiredToolImg}}">
          <input type="hidden" name="requiredToolType" value="{{requiredToolType}}">
          <input type="hidden" name="requiredToolIdentifier" value="{{requiredToolIdentifier}}">
          <input type="hidden" name="requiredToolSourceUuid" value="{{requiredToolSourceUuid}}">
        </div>
      </div>

      <div class="et-config-rule-card">
        <header><span class="et-rule-number">3</span><span><b>Disarm Attempt</b><small>Limits and consequences for each attempt.</small></span></header>
        <div class="et-config-toggle-grid">
          <label class="et-toggle-card"><span><b>One attempt per character</b><small>On by default. Attempts are tracked by Actor, not Token.</small></span><input type="checkbox" name="oneAttemptPerActor" {{checked discovery.disarm.oneAttemptPerActor}}></label>
          <label class="et-toggle-card"><span><b>Natural 1 triggers the trap</b><small>Optional house rule. Off by default.</small></span><input type="checkbox" name="naturalOneTriggers" {{checked discovery.disarm.naturalOneTriggers}}></label>
          <label class="et-toggle-card"><span><b>Always disarm on critical</b><small>Optional house rule. A natural 20 disarms even if the total is below the DC. Off by default.</small></span><input type="checkbox" name="alwaysDisarmOnCritical" {{checked discovery.disarm.alwaysDisarmOnCritical}}></label>
          <label class="et-toggle-card"><span><b>Show Disarm DC on result card</b><small>Off by default. Reveal the DC only when you want players to see it after the attempt.</small></span><input type="checkbox" name="showDcInChat" {{checked showDcInChat}}></label>
          <label class="et-toggle-card"><span><b>Dangerous failure</b><small>Optional trap-specific consequence. Off by default.</small></span><input type="checkbox" name="dangerousFailure" {{checked discovery.disarm.dangerousFailure}}></label>
        </div>
        <label class="et-field et-threshold-field"><span>Trigger on disarm total ≤</span><input type="number" name="dangerousThreshold" min="0" max="98" step="1" value="{{discovery.disarm.dangerousThreshold}}"></label>
      </div>

      <div class="et-config-note"><i class="fa-solid fa-circle-info"></i><span>The required Item is optional and defaults to Thieves' Tools when enabled. Sleight of Hand proficiency, Natural 1 activation, critical auto-disarm, and Dangerous Failure are independent optional rules.</span></div>
    </div>
  </section>

  <footer class="et-config-footer">
    <button type="button" class="et-reset-button" data-action="reset-defaults"><i class="fa-solid fa-rotate-left"></i> Restore factory defaults</button>
    <button type="submit" class="et-save-button"><i class="fa-solid fa-floppy-disk"></i> Save configuration</button>
  </footer>
</form>
